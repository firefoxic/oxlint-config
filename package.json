{
	"name": "@firefoxic/oxlint-config",
	"description": "Shared config for oxlint by firefoxic.",
	"version": "0.4.0",
	"license": "MIT",
	"author": {
		"name": "Sergey Artemov",
		"email": "firefoxic.dev@gmail.com"
	},
	"homepage": "https://github.com/firefoxic/oxlint-config#readme",
	"bugs": {
		"url": "https://github.com/firefoxic/oxlint-config/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/firefoxic/oxlint-config.git"
	},
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=26.9",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": ">=12.4",
			"onFail": "download"
		}
	},
	"files": [
		"./lib/**/*.d.ts",
		"./lib/**/*.js",
		"./lib/**/*.jsonc",
		"!**/*.test.js"
	],
	"scripts": {
		"help": "make help",
		"prepare": "git config --local core.hooksPath .githooks || true"
	},
	"peerDependencies": {
		"oxlint": "^1.83"
	},
	"dependencies": {
		"@stylistic/eslint-plugin": "^5",
		"eslint-plugin-simple-import-sort": "^14"
	},
	"devDependencies": {
		"@typescript-eslint/parser": "^8",
		"eslint": "^10",
		"oxlint": "^1"
	},
	"keywords": [
		"config",
		"oxlint",
		"javascript",
		"js",
		"lint",
		"linter",
		"linting"
	]
}
