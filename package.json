{
	"name": "@firefoxic/oxlint-config",
	"description": "Shared config for oxlint by firefoxic.",
	"version": "0.5.0",
	"license": "MIT",
	"author": {
		"name": "Sergey Artemov",
		"email": "firefoxic.dev@gmail.com"
	},
	"homepage": "https://github.com/firefoxic/oxlint-config#readme",
	"bugs": {
		"url": "https://github.com/firefoxic/oxlint-config/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/firefoxic/oxlint-config.git"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./syntactic": {
			"types": "./dist/syntactic.d.ts",
			"default": "./dist/syntactic.js"
		},
		"./stylistic": {
			"types": "./dist/stylistic.d.ts",
			"default": "./dist/stylistic.js"
		},
		"./syntactic.json": "./dist/syntactic.json",
		"./stylistic.json": "./dist/stylistic.json",
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22.18"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=26.9",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": ">=12.4",
			"onFail": "download"
		}
	},
	"scripts": {
		"help": "make help",
		"prepare": "git config --local core.hooksPath .githooks || true",
		"prepack": "make build"
	},
	"peerDependencies": {
		"oxlint": "^1.83"
	},
	"dependencies": {
		"@stylistic/eslint-plugin": "^5",
		"eslint-plugin-simple-import-sort": "^14"
	},
	"devDependencies": {
		"@types/node": "^26",
		"ajv": "^8",
		"oxlint": "^1",
		"typescript": "^7",
		"vitest": "^5"
	},
	"keywords": [
		"config",
		"oxlint",
		"javascript",
		"js",
		"lint",
		"linter",
		"linting",
		"typescript",
		"ts"
	]
}
